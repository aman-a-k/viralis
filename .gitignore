# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local agent/tooling config — not part of the project itself
.claude/
CLAUDE.md
AGENTS.md

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# video processing artifacts
/public/temp/
/public/uploads/*
/public/clips/*
!/public/uploads/.gitkeep
!/public/clips/.gitkeep
