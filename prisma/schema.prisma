generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Video {
  id          String   @id @default(cuid())
  topic       String
  videoUrl    String
  views       Int      @default(0)
  likes       Int      @default(0)
  platform    String   // "youtube", "instagram", "both"
  status      String   // "success", "failed", "pending"
  createdAt   DateTime @default(now())
}

model ApprovalQueue {
  id              String   @id @default(cuid())
  topic           String
  script          String
  visualPrompts   String   // JSON
  captions        String   // JSON
  status          String   @default("pending") // "pending", "approved", "rejected"
  rejectionReason String?
  createdAt       DateTime @default(now())
}

model Trend {
  id          String   @id @default(cuid())
  topic       String
  score       Int
  keywords    String   // JSON stringified array
  isViable    Boolean  @default(true)
  analysis    String?
  createdAt   DateTime @default(now())
}

model Analytics {
  id              String   @id @default(cuid())
  totalViews      Int      @default(0)
  totalRevenue    Float    @default(0.0)
  engagementRate  Float    @default(0.0)
  subscribersGained Int    @default(0)
  lastUpdated     DateTime @default(now())
}

model Settings {
  id                    String   @id @default("default")
  youtubeId             String?
  instagramId           String?
  openAiKey             String?
  
  // YouTube OAuth
  youtubeClientId       String?
  youtubeClientSecret   String?
  youtubeRefreshToken   String?

  // Instagram Graph API
  instagramAccessToken  String?

  // Brand Identity
  brandName             String?   @default("Automator AI")
  brandNiche            String?   @default("Technology & AI")
  brandTone             String?   @default("Professional & Engaging")
  targetAudience        String?   @default("General Tech Enthusiasts")
  defaultHashtags       String?   @default("ai,tech,trending")
  
  // Notification Hooks
  discordWebhookUrl     String?

  // Visual Assets & Voice (Pro Tier)
  pexelsApiKey          String?
  pixabayApiKey         String?
  elevenLabsApiKey      String?

  // Video Generation Preferences
  videoStyle            String?   @default("Cinematic Stock") // "Cinematic Stock", "AI Art Transitions"
  captionStyle          String?   @default("Dynamic Pop")     // "Dynamic Pop" (Hormozi style), "Minimalist"
  backgroundMusic       String?   @default("Trending Beats")
}

// NextAuth Models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
