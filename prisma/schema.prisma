generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Video {
  id          String   @id @default(cuid())
  topic       String
  videoUrl    String
  views       Int      @default(0)
  likes       Int      @default(0)
  platform    String   // "youtube", "instagram", "both"
  status      String   // "success", "failed", "pending"
  createdAt   DateTime @default(now())
}

model ApprovalQueue {
  id              String   @id @default(cuid())
  topic           String
  script          String
  visualPrompts   String   // JSON
  captions        String   // JSON
  seoTitle        String?
  seoDescription  String?
  seoTags         String?  // JSON
  status          String   @default("pending") // "pending", "approved", "rejected"
  rejectionReason String?
  createdAt       DateTime @default(now())

  // Links back to the repurposed Clip this entry came from (unset for
  // Autopilot-generated scripts, which have no source clip to cut).
  clipId          String?
  renderStatus    String?  // null | "pending" | "rendering" | "rendered" | "failed"
  renderError     String?
}

model Trend {
  id          String   @id @default(cuid())
  topic       String
  score       Int
  keywords    String   // JSON stringified array
  isViable    Boolean  @default(true)
  analysis    String?
  createdAt   DateTime @default(now())
}

model Analytics {
  id              String   @id @default(cuid())
  totalViews      Int      @default(0)
  totalRevenue    Float    @default(0.0)
  engagementRate  Float    @default(0.0)
  subscribersGained Int    @default(0)
  lastUpdated     DateTime @default(now())
}

model Settings {
  id                    String   @id @default("default")
  youtubeId             String?
  instagramId           String?
  openAiKey             String?   // legacy — see aiApiKey

  // AI provider (OpenAI-compatible). provider: "openai" | "gemini" | "groq"
  aiProvider            String?   @default("gemini")
  aiApiKey              String?
  aiModel               String?
  
  // YouTube OAuth
  youtubeClientId       String?
  youtubeClientSecret   String?
  youtubeRefreshToken   String?

  // YouTube Data API (trending discovery — separate from the OAuth upload creds above)
  youtubeDataApiKey     String?

  // Repurpose defaults (JSON string arrays)
  defaultPlatforms      String?   @default("[\"instagram\",\"youtube\",\"linkedin\",\"twitter\",\"tiktok\"]")
  defaultOrientations   String?   @default("[\"9:16\",\"1:1\",\"16:9\"]")

  // Instagram Graph API
  instagramAccessToken  String?

  // Brand Identity
  brandName             String?   @default("Viralis")
  brandNiche            String?   @default("Technology & AI")
  brandTone             String?   @default("Punchy & Viral")
  targetAudience        String?   @default("Social Media Audience")
  defaultHashtags       String?   @default("viral,shorts,trending,growth")
  
  // Notification Hooks
  discordWebhookUrl     String?

  // Visual Assets & Voice (Pro Tier)
  pexelsApiKey          String?
  pixabayApiKey         String?
  elevenLabsApiKey      String?

  // Video Generation Preferences
  videoStyle            String?   @default("Cinematic Stock") // "Cinematic Stock", "AI Art Transitions"
  captionStyle          String?   @default("Dynamic Pop")     // "Dynamic Pop" (Hormozi style), "Minimalist"
  backgroundMusic       String?   @default("Trending Beats")
}

// Viralis Core Models (Repurposing & Self-Optimizing Distribution)
model Project {
  id              String   @id @default(cuid())
  title           String
  sourceVideoUrl  String?
  sourceVideoId   String?  // YouTube video id when sourceType == "youtube"
  sourceType      String   @default("upload") // "upload", "youtube", "drive", "zoom"
  channel         String?
  thumbnail       String?
  transcript      String?  // Full caption transcript text
  transcriptJson  String?  // JSON array of { text, start, end }
  duration        Float?   @default(0)
  status          String   @default("ready")  // "processing", "transcribing", "ready", "failed"
  errorMessage    String?
  transcriptJobId String?  // worker job id while status == "transcribing"
  metadata        String?  // JSON string
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  clips           Clip[]
}

model Clip {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title             String
  startTime         Float
  endTime           Float
  duration          Float
  viralityScore     Int      @default(85)
  reasoning         String
  hookType          String?
  aspectRatios      String   @default("[\"9:16\",\"1:1\",\"16:9\"]") // JSON
  transcriptSegment String
  captionVersions   String   // JSON: { "instagram": "...", "youtube": "...", "linkedin": "...", "twitter": "...", "tiktok": "..." }
  videoUrl          String?
  status            String   @default("candidate") // "candidate", "approved", "scheduled", "published", "rejected"
  createdAt         DateTime @default(now())
  schedules         Schedule[]
  metrics           Metric[]
}

model Schedule {
  id            String    @id @default(cuid())
  clipId        String?
  clip          Clip?     @relation(fields: [clipId], references: [id], onDelete: Cascade)
  platform      String    // "instagram", "youtube", "linkedin", "twitter", "tiktok"
  scheduledTime DateTime
  publishedTime DateTime?
  status        String    @default("pending") // "pending", "published", "failed"
  postId        String?
  createdAt     DateTime  @default(now())
}

model Metric {
  id              String   @id @default(cuid())
  clipId          String?
  clip            Clip?    @relation(fields: [clipId], references: [id], onDelete: Cascade)
  platform        String
  views           Int      @default(0)
  likes           Int      @default(0)
  shares          Int      @default(0)
  comments        Int      @default(0)
  saves           Int      @default(0)
  watchThroughPct Float    @default(0.0)
  rootCauseTag    String?  // e.g. "hook too slow", "wrong platform fit", "topic saturation"
  fetchedAt       DateTime @default(now())
}

model TrendSignal {
  id            String   @id @default(cuid())
  niche         String
  topic         String
  trendingScore Int      @default(80)
  format        String?  // e.g. "contrarian debate", "breakdown", "hook question"
  detectedAt    DateTime @default(now())
}

// NextAuth Models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
