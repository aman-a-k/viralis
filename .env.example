# ═════════════════════════════════════════════════════════════════════
#  Viralis — web app environment (Vercel project settings, or .env.local)
#  The media worker has its own variables: see worker/README.md.
# ═════════════════════════════════════════════════════════════════════

# ── Required ─────────────────────────────────────────────────────────

# PostgreSQL. DATABASE_URL is the pooled connection; DIRECT_URL is unpooled
# (used only by `prisma migrate`).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth: `openssl rand -base64 32`, and the site's full origin.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="https://your-domain.example"
# Used in emailed links. Defaults to NEXTAUTH_URL.
APP_URL="https://your-domain.example"

# Encrypts stored OAuth tokens. `openssl rand -base64 32` (exactly 32 bytes).
# Keep it safe: losing it means channels must be reconnected.
ENCRYPTION_KEY=""

# AI used to find clips and write captions. gemini | groq | openai
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
# GROQ_API_KEY=""
# OPENAI_API_KEY=""
# AI_MODEL=""            # optional override of the provider's default model

# Vercel Blob read-write token. Use a PRIVATE Blob store for customer media.
BLOB_READ_WRITE_TOKEN=""
# "private" (default; requires a private store) or "public" (legacy store).
BLOB_ACCESS="private"

# Media worker (see worker/README.md). Same secret on both sides.
RENDER_WORKER_URL="https://your-worker.onrender.com"
RENDER_WORKER_SECRET=""

# Vercel Cron sends this as a bearer token to /api/cron/daily.
CRON_SECRET=""

# ── Strongly recommended for a public launch ─────────────────────────

# Transactional email (verification, password reset, invites) via Resend.
# EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=""
EMAIL_FROM="Viralis <hello@your-domain.example>"
SUPPORT_EMAIL="support@your-domain.example"

# Payments via Razorpay. Create one monthly plan per paid plan in
# src/lib/plans.ts, then paste their plan ids here. Webhook URL:
# <APP_URL>/api/billing/webhook  (subscribe to subscription.* events)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_PLAN_CREATOR=""
# RAZORPAY_PLAN_GROWTH=""
# PLAN_GROWTH_ENABLED="false"

# Operators: comma-separated emails that see the Admin view and aren't metered.
ADMIN_EMAILS=""

# ── Optional ─────────────────────────────────────────────────────────

# "Sign in with Google". Also used for YouTube connections unless the
# YOUTUBE_OAUTH_* pair below is set. Redirect URIs to register in Google Cloud:
#   <APP_URL>/api/auth/callback/google
#   <APP_URL>/api/auth/youtube/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# YOUTUBE_OAUTH_CLIENT_ID=""
# YOUTUBE_OAUTH_CLIENT_SECRET=""

# YouTube Data API key: trending videos and video-length checks.
YOUTUBE_API_KEY=""

# "open" (default) or "invite" (only ALLOWED_EMAILS and invited people).
SIGNUP_MODE="open"
# ALLOWED_EMAILS=""

# Shown on the landing page when set (a real example you have rights to).
# NEXT_PUBLIC_DEMO_VIDEO_URL=""

# Name shown as the operator in the legal pages.
# LEGAL_OPERATOR_NAME=""
