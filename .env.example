# ─────────────────────────────────────────────────────────────
# Database — PostgreSQL (Neon, Supabase, Vercel Postgres, etc.)
# Local dev and production both use Postgres. Use the POOLED
# connection string from your provider.
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# DIRECT_URL: unpooled connection, used by `prisma migrate`. On Neon it's the
# DATABASE_URL host with "-pooler" removed. If your provider has no separate
# unpooled URL, set it to the same value as DATABASE_URL.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─────────────────────────────────────────────────────────────
# NextAuth — REQUIRED in every environment
#   NEXTAUTH_SECRET: generate with `openssl rand -base64 32`
#   NEXTAUTH_URL:    the full origin of the deployment
# ─────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Optional: Google OAuth. If both are set, "Continue with Google"
# appears on the sign-in page. If unset, email/password still works.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Who may create an account (comma-separated). Every account shares one
# workspace, so sign-up is invite-only. If unset, only the very first
# account can be created.
ALLOWED_EMAILS=""

# Optional: allow the one-click "Developer bypass" login in production.
# Leave unset/false for real deployments.
ENABLE_DEV_LOGIN="false"

# ─────────────────────────────────────────────────────────────
# AI provider (any one is enough). A key saved in Settings → AI Engine
# takes precedence; these are the fallback. Gemini and Groq have free tiers.
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENAI_API_KEY=""
# Optional: which of the above to prefer (gemini | groq | openai), and a model override.
AI_PROVIDER=""
AI_MODEL=""

# ─────────────────────────────────────────────────────────────
# Trending discovery — YouTube Data API v3 key (free). Can also be
# saved in Settings → Trending Discovery.
# ─────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=""

# ─────────────────────────────────────────────────────────────
# Render worker (see worker/README.md) — needed to cut real video
# files and to transcribe videos YouTube won't serve captions for.
# ─────────────────────────────────────────────────────────────
RENDER_WORKER_URL=""
RENDER_WORKER_SECRET=""
