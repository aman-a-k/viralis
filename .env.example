# ─────────────────────────────────────────────────────────────
# Database — PostgreSQL (Neon, Supabase, Vercel Postgres, etc.)
# Local dev and production both use Postgres. Use the POOLED
# connection string from your provider.
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# DIRECT_URL: unpooled connection, used only by `prisma migrate`. On Neon it's
# the DATABASE_URL host with "-pooler" removed. Falls back to DATABASE_URL if unset.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─────────────────────────────────────────────────────────────
# NextAuth — REQUIRED in every environment
#   NEXTAUTH_SECRET: generate with `openssl rand -base64 32`
#   NEXTAUTH_URL:    the full origin of the deployment
# ─────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Optional: Google OAuth. If both are set, "Continue with Google"
# appears on the sign-in page. If unset, email/password still works.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: allow the one-click "Developer bypass" login in production.
# Leave unset/false for real deployments.
ENABLE_DEV_LOGIN="false"

# ─────────────────────────────────────────────────────────────
# AI & Media API keys (optional — features degrade gracefully)
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=""
ELEVENLABS_API_KEY=""
PEXELS_API_KEY=""
PIXABAY_API_KEY=""
